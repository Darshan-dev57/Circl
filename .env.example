# copy to .env (git-ignored) and change for anything that is not your laptop
POSTGRES_DB=circl
POSTGRES_USER=circl
POSTGRES_PASSWORD=circl

# used by "docker compose --profile app"; make each one a long random string (32+ characters)
# e.g. openssl rand -base64 48
CIRCL_JWT_SECRET=
CIRCL_CHECKIN_SECRET=
